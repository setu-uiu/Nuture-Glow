{
  "name": "nurture-glow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "predev": "node scripts/free-port.mjs",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "migrate": "node src/migrate.js",
    "migrate:status": "node src/migrate.js --status",
    "migrate:down": "node src/migrate.js --down",
    "setup-email": "node setup-email.js",
    "reset-donors": "node reset-donors.js",
    "healthcheck": "node -e \"fetch('http://localhost:' + (process.env.PORT||4000) + '/api/health').then(r=>{if(!r.ok)throw r;process.exit(0)}).catch(()=>process.exit(1))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^9.15.1",
    "googleapis": "^118.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.11.3",
    "nodemailer": "^7.0.12",
    "uuid": "^9.0.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
